# ==============================================================================
# MATB STS PREP - Environment Variables & API Keys
# ==============================================================================
# NOTE FOR VERCEL DEPLOYMENT:
# - Core application features (MCQs, quizzes, past papers, jobs, current affairs,
#   bookmarks, mistakes notebook) run completely client-side without any mandatory
#   API keys. You can deploy to Vercel without setting any environment variables!
# - If you wish to enable optional enhanced services, configure the keys below
#   in your Vercel Project Settings -> Environment Variables.
# ==============================================================================

# [OPTIONAL] OpenAI API Key
# Used only on the server for ChatGPT explanations and the study assistant.
# Create a key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=""

# [OPTIONAL] OpenAI model. The default is gpt-5-mini.
OPENAI_MODEL="gpt-5-mini"

# [OPTIONAL] Production Application URL
# Set this to your live domain (e.g. https://matbstsprep.app).
APP_URL="https://matbstsprep.app"
VITE_APP_URL="https://matbstsprep.app"

# [OPTIONAL] Google Analytics Measurement ID (GA4)
# If you want to track aspirant traffic and test completions (e.g. G-XXXXXXXXXX).
VITE_GA_MEASUREMENT_ID=""
